{
  "expo": {
    "name": "FECNA Agent",
    "slug": "fecna-agent",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "co.fecna.agent"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "co.fecna.agent"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png",
      "name": "FECNA Agent",
      "shortName": "FECNA",
      "themeColor": "#023E8A",
      "backgroundColor": "#F5FAFF"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#023E8A"
        }
      ],
      "expo-sharing"
    ],
    "scheme": "fecna",
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "e0cc7b2a-296d-4e23-aa92-8ef486323ef8"
      }
    },
    "owner": "leyeguemen",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/e0cc7b2a-296d-4e23-aa92-8ef486323ef8"
    }
  }
}
