# Plantilla de secretos locales de Streamlit.
# Cópiala a `.streamlit/secrets.toml` (ese archivo está ignorado por git) y
# reemplaza los valores. Con esto la app pide login al arrancar `streamlit run app.py`.

# Activa el candado de acceso (login + registro). Sin esta variable, la app
# funciona sin login (modo local de siempre).
FECNA_AUTH = "1"

# Email(s) con rol admin (cargar/borrar programas, controles de extracción).
# Uno o varios separados por coma. El resto de usuarios son normales.
FECNA_ADMIN_EMAIL = "tu@correo.com"

# --- Opcionales (no relacionados con el login) ---
# FECNA_PUBLIC = "1"                 # modo público anonimizado
# FECNA_DB = "data/fecna_public.db"  # base a usar
